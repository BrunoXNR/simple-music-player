<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+: no cloud backup and no device-to-device transfer. Favorites, playlists and the saved
    queue reference MediaStore song IDs, which differ on another phone, so restoring them there would
    point to the wrong songs.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
