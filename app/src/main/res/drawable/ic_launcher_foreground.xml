<?xml version="1.0" encoding="utf-8"?>
<!-- Classic vinyl record: dark disc with grooves, light sheen, amber label.
     Disc radius 29dp, inside the adaptive icon safe zone (33dp of the 108dp canvas). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Disc, with the center hole cut through to the background -->
    <path
        android:fillColor="@color/ic_launcher_disc"
        android:fillType="evenOdd"
        android:pathData="M54,25 A29,29 0 1,1 54,83 A29,29 0 1,1 54,25 Z
            M54,52 A2,2 0 1,1 54,56 A2,2 0 1,1 54,52 Z" />
    <!-- Grooves: 1dp rings at radii 25, 21 and 17 -->
    <path
        android:fillColor="@color/ic_launcher_groove"
        android:fillType="evenOdd"
        android:pathData="M54,29 A25,25 0 1,1 54,79 A25,25 0 1,1 54,29 Z
            M54,30 A24,24 0 1,1 54,78 A24,24 0 1,1 54,30 Z
            M54,33 A21,21 0 1,1 54,75 A21,21 0 1,1 54,33 Z
            M54,34 A20,20 0 1,1 54,74 A20,20 0 1,1 54,34 Z
            M54,37 A17,17 0 1,1 54,71 A17,17 0 1,1 54,37 Z
            M54,38 A16,16 0 1,1 54,70 A16,16 0 1,1 54,38 Z" />
    <!-- Sheen: two opposite light wedges -->
    <path
        android:fillAlpha="0.14"
        android:fillColor="#FFFFFF"
        android:pathData="M54,54 L33.5,33.5 A29,29 0 0,1 41.7,27.7 Z
            M54,54 L74.5,74.5 A29,29 0 0,1 66.3,80.3 Z" />
    <!-- Label with center hole -->
    <path
        android:fillColor="@color/ic_launcher_label"
        android:fillType="evenOdd"
        android:pathData="M54,43 A11,11 0 1,1 54,65 A11,11 0 1,1 54,43 Z
            M54,52 A2,2 0 1,1 54,56 A2,2 0 1,1 54,52 Z" />
</vector>
